# raspdac-display — Media player and Charge System display (Winstar HD44780-compatible OLED) service

[Unit]
Description=Media player and Charge System display (Winstar OLED) for RaspDAC
After=dbus.service

[Service]
ExecStart=/usr/local/bin/raspdac-display
Environment=RUST_LOG=info
StandardOutput=append:/home/qobuz/display_out.log
StandardError=append:/home/qobuz/display_err.log
KillSignal=SIGINT
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
